{
  "name": "myfuture-news-test",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "build": "npm run build:web && npm run build:api",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "test:web": "tsx --test apps/web/test/**/*.spec.ts",
    "test:api": "tsx --test apps/api/test/**/*.spec.ts",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "typecheck:api": "npm --workspace apps/api run typecheck",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "sync:news-images": "tsx scripts/sync-researched-news-images.ts",
    "import:official-news": "tsx scripts/import-official-news.ts",
    "import:official-news:dry-run": "tsx scripts/import-official-news.ts --dry-run"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^6.4.0",
    "tsx": "^4.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0"
  }
}
